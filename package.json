{
  "name": "with-vite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prisma:migrate-dev": "pnpm --filter @repo/database exec prisma migrate dev",
    "prisma:generate": "pnpm --filter @repo/database exec prisma generate",
    "prisma:seed": "pnpm --filter @repo/database exec prisma db seed"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "3.9.6",
    "turbo": "^2.11.4"
  },
  "engines": {
    "node": "\u003e=24.20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
